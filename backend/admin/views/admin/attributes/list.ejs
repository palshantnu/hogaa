<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container-fluid px-4 py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4><i class="fas fa-tags text-primary me-2"></i>Product Attributes</h4>
            <a href="/admin/products/attributes/add" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Attribute
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Slug</th>
                                <th>Type</th>
                                <th>Values</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (attributes && attributes.length > 0) { %>
                                <% attributes.forEach(attr => { %>
                                    <tr>
                                        <td><%= attr.id %></td>
                                        <td><%= attr.name %></td>
                                        <td><%= attr.slug %></td>
                                        <td>
                                            <span class="badge bg-info"><%= attr.type %></span>
                                        </td>
                                        <td>
                                            <% if (attr.values && attr.values.length > 0) { %>
                                                <% attr.values.forEach(val => { %>
                                                    <span class="badge bg-secondary me-1">
                                                        <%= val.value %>
                                                        <% if (val.color_code) { %>
                                                            <span style="display:inline-block; width:12px; height:12px; background:<%= val.color_code %>; border-radius:50%; margin-left:5px;"></span>
                                                        <% } %>
                                                    </span>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="text-muted">No values</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= attr.status === 'active' ? 'success' : 'danger' %>">
                                                <%= attr.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/admin/products/attributes/edit/<%= attr.id %>" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/admin/products/attributes/delete/<%= attr.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center">No attributes found. <a href="/admin/products/attributes/add">Create your first attribute</a></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (pagination && pagination.pages > 1) { %>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">Showing page <%= pagination.page %> of <%= pagination.pages %> (<%= pagination.total %> attributes)</div>
                    <nav>
                        <ul class="pagination mb-0">
                            <% if (pagination.page > 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= pagination.page - 1 %>">Previous</a>
                                </li>
                            <% } %>
                            <% for (let i = 1; i <= pagination.pages && i <= 5; i++) { %>
                                <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>
                            <% if (pagination.page < pagination.pages) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= pagination.page + 1 %>">Next</a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>