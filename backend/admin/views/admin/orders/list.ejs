<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders | Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" rel="stylesheet">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #f0f2f5; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
        
        .card { border: none; border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); overflow: hidden; }
        .card-header { background: white; border-bottom: 1px solid #e9ecef; padding: 1.25rem 1.5rem; font-weight: 600; font-size: 1.1rem; }
        
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.25rem;
            transition: all 0.3s ease;
            border: 1px solid #e9ecef;
            position: relative;
            overflow: hidden;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
        .stat-icon {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 2.5rem;
            opacity: 0.15;
        }
        .stat-value { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.25rem; }
        .stat-label { font-size: 0.8rem; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .filter-container {
            background: white;
            border-radius: 20px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            border: 1px solid #e9ecef;
        }
        .filter-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            margin-bottom: 0.75rem;
        }
        .filter-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 500;
            background: #f8f9fa;
            color: #495057;
            transition: all 0.2s;
            text-decoration: none;
            margin: 0 4px 8px 0;
        }
        .filter-badge.active { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        
        .badge-status {
            padding: 5px 12px;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-processing { background: #cce5ff; color: #004085; }
        .badge-shipped { background: #d1ecf1; color: #0c5460; }
        .badge-delivered { background: #d4edda; color: #155724; }
        .badge-cancelled { background: #f8d7da; color: #721c24; }
        .badge-paid { background: #d4edda; color: #155724; }
        .badge-pending-payment { background: #fff3cd; color: #856404; }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 8px 18px;
            font-size: 0.8rem;
            font-weight: 500;
            transition: all 0.2s;
            color: white;
        }
        .btn-primary-custom:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(102,126,234,0.3); color: white; }
        
        .dataTables_wrapper .dataTables_length select { padding: 5px 10px; border-radius: 8px; border: 1px solid #e9ecef; }
        .dataTables_wrapper .dataTables_filter input { padding: 6px 12px; border-radius: 8px; border: 1px solid #e9ecef; }
        .dt-buttons { margin-bottom: 15px; }
        .dt-button { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 6px 15px; border-radius: 8px; margin-right: 5px; }
        
        .custom-checkbox { width: 18px; height: 18px; cursor: pointer; accent-color: #667eea; }
        .status-select { padding: 5px 10px; border-radius: 8px; border: 1px solid #e9ecef; font-size: 0.75rem; }
        .table-responsive { overflow-x: auto; }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.5rem 0.75rem;
            margin: 0 2px;
            border-radius: 0.375rem;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: white !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #e9ecef;
            border-color: #dee2e6;
        }
        @media (max-width: 768px) {
            .stat-value { font-size: 1.2rem; }
            .filter-badge { padding: 4px 10px; font-size: 0.7rem; }
        }
    </style>
</head>
<body>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold"><i class="fas fa-shopping-cart text-primary me-2"></i>Orders Management</h4>
            <p class="text-muted small mb-0">Manage and track all customer orders</p>
        </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
                <div class="stat-value">₹<%= (summary.totalRevenue || 0).toLocaleString() %></div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
                <div class="stat-value"><%= summary.total || 0 %></div>
                <div class="stat-label">Total Orders</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
                <div class="stat-value">₹<%= Math.round(summary.avgOrderValue || 0).toLocaleString() %></div>
                <div class="stat-label">Avg Order Value</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div class="stat-value"><%= summary.pending || 0 %></div>
                <div class="stat-label">Pending Orders</div>
            </div>
        </div>
    </div>
    
    <!-- Filter Section -->
    <div class="filter-container">
        <form method="GET" action="/admin/orders" id="filterForm">
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <div class="filter-label"><i class="fas fa-tag"></i> Order Status</div>
                    <div>
                        <a href="/admin/orders?status=all" class="filter-badge <%= filters.status === 'all' ? 'active' : '' %>">All</a>
                        <a href="/admin/orders?status=pending" class="filter-badge <%= filters.status === 'pending' ? 'active' : '' %>">Pending</a>
                        <a href="/admin/orders?status=processing" class="filter-badge <%= filters.status === 'processing' ? 'active' : '' %>">Processing</a>
                        <a href="/admin/orders?status=shipped" class="filter-badge <%= filters.status === 'shipped' ? 'active' : '' %>">Shipped</a>
                        <a href="/admin/orders?status=delivered" class="filter-badge <%= filters.status === 'delivered' ? 'active' : '' %>">Delivered</a>
                        <a href="/admin/orders?status=cancelled" class="filter-badge <%= filters.status === 'cancelled' ? 'active' : '' %>">Cancelled</a>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-2">
                    <div class="filter-label"><i class="fas fa-credit-card"></i> Payment Status</div>
                    <div>
                        <a href="/admin/orders?payment_status=all" class="filter-badge <%= filters.payment_status === 'all' ? 'active' : '' %>">All</a>
                        <a href="/admin/orders?payment_status=paid" class="filter-badge <%= filters.payment_status === 'paid' ? 'active' : '' %>">Paid</a>
                        <a href="/admin/orders?payment_status=pending" class="filter-badge <%= filters.payment_status === 'pending' ? 'active' : '' %>">Pending</a>
                        <a href="/admin/orders?payment_status=failed" class="filter-badge <%= filters.payment_status === 'failed' ? 'active' : '' %>">Failed</a>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-2">
                    <div class="filter-label"><i class="fas fa-wallet"></i> Payment Method</div>
                    <div>
                        <a href="/admin/orders?payment_method=all" class="filter-badge <%= filters.payment_method === 'all' ? 'active' : '' %>">All</a>
                        <a href="/admin/orders?payment_method=cod" class="filter-badge <%= filters.payment_method === 'cod' ? 'active' : '' %>">COD</a>
                        <a href="/admin/orders?payment_method=payu" class="filter-badge <%= filters.payment_method === 'payu' ? 'active' : '' %>">PayU</a>
                        <a href="/admin/orders?payment_method=card" class="filter-badge <%= filters.payment_method === 'card' ? 'active' : '' %>">Card</a>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="filter-label"><i class="fas fa-calendar"></i> Date Range</div>
                    <select name="date_range" class="form-select form-select-sm" onchange="this.form.submit()" style="border-radius: 12px; padding: 8px;">
                        <option value="">All Time</option>
                        <option value="today" <%= filters.date_range === 'today' ? 'selected' : '' %>>Today</option>
                        <option value="week" <%= filters.date_range === 'week' ? 'selected' : '' %>>Last 7 Days</option>
                        <option value="month" <%= filters.date_range === 'month' ? 'selected' : '' %>>Last 30 Days</option>
                        <option value="this_month" <%= filters.date_range === 'this_month' ? 'selected' : '' %>>This Month</option>
                    </select>
                </div>
                
                <div class="col-md-6 col-lg-2">
                    <div class="filter-label"><i class="fas fa-sort"></i> Sort By</div>
                    <select name="sort_by" class="form-select form-select-sm" onchange="this.form.submit()" style="border-radius: 12px; padding: 8px;">
                        <option value="newest" <%= filters.sort_by === 'newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%= filters.sort_by === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="highest_amount" <%= filters.sort_by === 'highest_amount' ? 'selected' : '' %>>Highest Amount</option>
                        <option value="lowest_amount" <%= filters.sort_by === 'lowest_amount' ? 'selected' : '' %>>Lowest Amount</option>
                    </select>
                </div>
            </div>
            
            <div class="row mt-3">
                <div class="col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Order Number, Customer Name, Phone or Email..." value="<%= filters.search %>">
                        <button type="submit" class="btn btn-primary-custom rounded-end-3">Search</button>
                        <a href="/admin/orders" class="btn btn-outline-secondary ms-2 rounded-3">Clear All</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
    
    <!-- Orders Table with DataTables -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list me-2"></i>All Orders</span>
            <span class="badge bg-secondary rounded-pill"><%= pagination.total %> Orders</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="ordersTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll" class="custom-checkbox"></th>
                            <th>Order ID</th>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Payment</th>
                            <th>Payment Status</th>
                            <th>Order Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                            <tr>
                                <td><input type="checkbox" class="orderCheckbox custom-checkbox" value="<%= order.id %>"></td>
                                <td>#<%= order.id %></td>
                                <td><code><%= order.order_number %></code></td>
                                <td>
                                    <div class="fw-semibold"><%= order.user ? order.user.name : 'Guest' %></div>
                                    <small class="text-muted"><%= order.user ? order.user.email : '' %></small>
                                 </td>
                                <td><span class="fw-bold">₹<%= parseFloat(order.total).toLocaleString('en-IN') %></span></td>
                                <td>
                                    <span class="badge-status <%= order.payment_method === 'payu' ? 'badge-paid' : 'badge-pending-payment' %>">
                                        <i class="fas <%= order.payment_method === 'payu' ? 'fa-check' : 'fa-clock' %>"></i>
                                        <%= order.payment_method ? order.payment_method.toUpperCase() : 'COD' %>
                                    </span>
                                 </td>
                                <td>
                                    <span class="badge-status <%= order.payment_status === 'paid' ? 'badge-paid' : (order.payment_status === 'failed' ? 'badge-failed' : 'badge-pending-payment') %>">
                                        <%= order.payment_status ? order.payment_status.toUpperCase() : 'PENDING' %>
                                    </span>
                                 </td>
                                <td>
                                    <select class="status-select" onchange="updateOrderStatus(<%= order.id %>, this.value)">
                                        <option value="pending" <%= order.order_status === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="processing" <%= order.order_status === 'processing' ? 'selected' : '' %>>Processing</option>
                                        <option value="shipped" <%= order.order_status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                        <option value="delivered" <%= order.order_status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                        <option value="cancelled" <%= order.order_status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                    </select>
                                 </td>
                                <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                <td>
                                    <a href="/admin/orders/view/<%= order.id %>" class="btn btn-sm btn-primary-custom">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="/admin/orders/invoice/<%= order.id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Print / Download Invoice">
                                        <i class="fas fa-file-invoice"></i>
                                    </a>
                                 </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="10" class="text-center">No orders found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<script>
    $(document).ready(function() {
        // Initialize DataTable with pagination and export
        const table = $('#ordersTable').DataTable({
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            order: [[8, 'desc']],
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of 0 entries",
                infoFiltered: "(filtered from _MAX_ total entries)",
                paginate: {
                    first: "First",
                    last: "Last",
                    next: "Next",
                    previous: "Previous"
                },
                zeroRecords: "No matching orders found"
            },
            dom: '<"d-flex justify-content-between align-items-center mb-3"<"dt-buttons"B><"dt-search"f>>rt<"d-flex justify-content-between align-items-center mt-3"<"dt-info"i><"dt-pagination"p>>',
            buttons: [
                {
                    extend: 'excel',
                    text: '<i class="fas fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-success btn-sm',
                    title: 'Orders_Report',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7, 8]
                    }
                },
                {
                    extend: 'csv',
                    text: '<i class="fas fa-file-csv me-1"></i> CSV',
                    className: 'btn btn-info btn-sm',
                    title: 'Orders_Report'
                },
                {
                    extend: 'print',
                    text: '<i class="fas fa-print me-1"></i> Print',
                    className: 'btn btn-secondary btn-sm',
                    title: 'Orders Report'
                },
                {
                    extend: 'copy',
                    text: '<i class="fas fa-copy me-1"></i> Copy',
                    className: 'btn btn-dark btn-sm'
                }
            ],
            columnDefs: [
                { orderable: false, targets: [0, 9] }
            ]
        });
        
        // Select All functionality
        $('#selectAll').on('change', function() {
            $('.orderCheckbox').prop('checked', $(this).prop('checked'));
            updateSelectedCount();
        });
        
        // Individual checkbox change
        $(document).on('change', '.orderCheckbox', function() {
            updateSelectedCount();
            $('#selectAll').prop('checked', $('.orderCheckbox:checked').length === $('.orderCheckbox').length);
        });
    });
    
    function updateSelectedCount() {
        const count = $('.orderCheckbox:checked').length;
        $('#selectedCount').text(count + ' selected');
        if (count > 0) {
            $('#bulkActionDiv').show();
        } else {
            $('#bulkActionDiv').hide();
        }
    }
    
    function updateOrderStatus(orderId, status) {
        if (confirm('Are you sure you want to update this order status?')) {
            fetch(`/admin/orders/update-status/${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: status })
            }).then(response => response.json())
              .then(data => {
                  if (data.success) {
                      location.reload();
                  } else {
                      alert('Failed to update status');
                  }
              }).catch(error => {
                  alert('Error updating status');
              });
        }
    }
    
    function applyBulkAction() {
        const action = $('#bulkAction').val();
        const selectedOrders = $('.orderCheckbox:checked').map(function() { return $(this).val(); }).get();
        
        if (!action) {
            alert('Please select an action');
            return;
        }
        
        if (selectedOrders.length === 0) {
            alert('Please select at least one order');
            return;
        }
        
        if (confirm(`Apply "${action}" to ${selectedOrders.length} order(s)?`)) {
            fetch('/admin/orders/bulk-update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_ids: selectedOrders, status: action })
            }).then(response => response.json())
              .then(data => {
                  if (data.success) {
                      location.reload();
                  } else {
                      alert('Failed to update orders');
                  }
              }).catch(error => {
                  alert('Error updating orders');
              });
        }
    }
    
    function exportToExcel() {
        $('#ordersTable').DataTable().button(0).trigger();
    }
</script>

<!-- Bulk Action Bar -->
<div id="bulkActionDiv" style="position: fixed; bottom: 20px; right: 20px; background: white; border-radius: 50px; padding: 10px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); display: none; z-index: 1000;">
    <div class="d-flex align-items-center gap-3">
        <span id="selectedCountText" class="fw-bold">0 selected</span>
        <select id="bulkAction" class="form-select form-select-sm" style="width: 150px;">
            <option value="">Bulk Actions</option>
            <option value="processing">Mark as Processing</option>
            <option value="shipped">Mark as Shipped</option>
            <option value="delivered">Mark as Delivered</option>
            <option value="cancelled">Mark as Cancelled</option>
        </select>
        <button class="btn btn-sm btn-primary" onclick="applyBulkAction()">Apply</button>
        <button class="btn btn-sm btn-secondary" onclick="$('#bulkActionDiv').hide(); $('.orderCheckbox').prop('checked', false); $('#selectAll').prop('checked', false);">Cancel</button>
    </div>
</div>

<script>
    // Update bulk action bar visibility
    function updateBulkActionBar() {
        const count = $('.orderCheckbox:checked').length;
        if (count > 0) {
            $('#bulkActionDiv').show();
            $('#selectedCountText').text(count + ' selected');
        } else {
            $('#bulkActionDiv').hide();
        }
    }
    
    $(document).on('change', '.orderCheckbox', function() {
        updateBulkActionBar();
        $('#selectAll').prop('checked', $('.orderCheckbox:checked').length === $('.orderCheckbox').length);
    });
    
    $('#selectAll').on('change', function() {
        $('.orderCheckbox').prop('checked', $(this).prop('checked'));
        updateBulkActionBar();
    });
</script>
</body>
</html>