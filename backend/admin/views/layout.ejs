<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || "Admin Panel" %></title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
  
  <!-- Select2 -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  
  <!-- Simple DataTables -->
  <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
  
  <!-- Custom CSS -->
  <link href="/sb-admin/css/styles.css" rel="stylesheet" />
</head>
<body class="sb-nav-fixed">
  
  <!-- Header -->
  <%- include('partials/header') %>
  
  <!-- Sidebar & Main Content -->
  <div id="layoutSidenav">
    <%- include('partials/sidebar') %>
    
    <div id="layoutSidenav_content">
      <main>
        <%- body %>
      </main>
      
      <!-- Footer -->
      <%- include('partials/footer') %>
    </div>
  </div>
  
  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>
  
  <!-- Custom Scripts -->
  <script src="/sb-admin/js/scripts.js"></script>
  <script src="/sb-admin/js/datatables-simple-demo.js"></script>
  <script src="/sb-admin/assets/demo/chart-area-demo.js"></script>
  <script src="/sb-admin/assets/demo/chart-bar-demo.js"></script>
  <script src="/sb-admin/assets/demo/chart-pie-demo.js"></script>
  <script src="/sb-admin/assets/demo/datatables-demo.js"></script>
  
  <style>
    /* Table last column styling */
    #datatablesSimple th:last-child,
    #datatablesSimple td:last-child {
      width: 210px;
      white-space: nowrap;
      text-align: center;
    }
  </style>
</body>
</html>