<style>
  .welcome-card2 {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;

  }
</style>
<nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark welcome-card2">
  <!-- Navbar Brand -->
  <a class="navbar-brand ps-3" href="/admin/dashboard">
    <i class="fas fa-store me-2"></i>Hogaa Admin
  </a>

  <!-- Sidebar Toggle -->
  <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Navbar Search -->
  <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
    <!-- <div class="input-group">
      <input class="form-control" type="text" placeholder="Search..." aria-label="Search" id="globalSearch" />
      <button class="btn btn-primary" type="button">
        <i class="fas fa-search"></i>
      </button>
    </div> -->
  </form>

  <!-- Navbar -->
  <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
    <li class="nav-item dropdown">
      <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown"
        aria-expanded="false">
        <i class="fas fa-user fa-fw"></i>
        <%= admin && admin.name ? admin.name : 'Guest' %>
      </a>
      <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
        <li><a class="dropdown-item" href="#!">
            <i class="fas fa-user-cog"></i> Profile Settings
          </a></li>
        <li>
          <hr class="dropdown-divider" />
        </li>
        <% if (admin) { %>
          <li><a class="dropdown-item text-danger" href="/admin/auth/logout">
              <i class="fas fa-sign-out-alt"></i> Logout
            </a></li>
          <% } %>
      </ul>
    </li>
  </ul>
</nav>

<script>
  // Global search functionality
  document.getElementById('globalSearch')?.addEventListener('keypress', function (e) {
    if (e.key === 'Enter') {
      const searchTerm = this.value;
      const currentPath = window.location.pathname;
      if (currentPath.includes('/admin/products')) {
        window.location.href = `/admin/products?search=${encodeURIComponent(searchTerm)}`;
      } else if (currentPath.includes('/admin/orders')) {
        window.location.href = `/admin/orders?search=${encodeURIComponent(searchTerm)}`;
      } else if (currentPath.includes('/admin/users')) {
        window.location.href = `/admin/users?search=${encodeURIComponent(searchTerm)}`;
      }
    }
  });
</script>